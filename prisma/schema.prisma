generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? // Adicionado para compatibilidade total com NextAuth
  password      String?
  name          String?
  image         String?

  systemPrompt String? @default("Você é um assistente especializado em organização de biblioteca de vídeos. Analise o conteúdo e sugira uma nomenclatura organizada, resumo e tópicos principais.")
  chatPrompt   String? @default("Você é um assistente virtual prestativo. Responda às dúvidas do usuário com base no contexto dos vídeos catalogados e em seu conhecimento geral de forma clara e objetiva.")

  catalogs     Catalog[]
  chatMessages ChatMessage[]
  chatSessions ChatSession[]

  // Relacionamentos para o NextAuth (Onde os tokens realmente moram)
  accounts         Account[]
  sessions         Session[]
  folders          Folder[]
  agendaBoards     AgendaBoard[]
  libraryDocuments LibraryDocument[]
  plans            Plan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Adicionei para seu controle
}

model Plan {
  id          String       @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns     PlanColumn[]
  rows        PlanRow[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, updatedAt])
}

model PlanColumn {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("TEXT")
  position  Int
  width     Int      @default(180)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, position])
  @@index([planId])
}

model PlanRow {
  id        String   @id @default(cuid())
  position  Int
  values    Json     @default("{}")
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, position])
  @@index([planId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  refresh_token_expires_in Int?
  user                     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Catalog {
  id              String  @id @default(cuid())
  fileName        String
  originalName    String?
  summary         String
  category        String
  subcategory     String?
  subject         String?
  author          String?
  duration        String?
  isWatchEveryDay Boolean @default(false)
  priority        Int?
  observations    String?

  // Campo para o RAG (Vetorização dos resumos)
  embedding Unsupported("vector(768)")?

  videoUrl     String? // A URL para assistir o vídeo futuramente
  sourceType   String? // 'FILE' (upload manual) ou 'URL' (link externo)
  mimeType     String? // Ex: 'video/mp4' (importante para o player)
  thumbnailUrl String? // Para mostrar a capa do vídeo na biblioteca

  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model ChatMessage {
  id      String @id @default(cuid())
  role    String // 'user' ou 'assistant'
  content String
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChatSession {
  id       String  @id @default(cuid())
  title    String // Ex: "Planejamento Aula 1"
  isPinned Boolean @default(false)
  userId   String
  user     User    @relation(fields: [userId], references: [id])

  messages ChatMessage[] // Uma sessão tem várias mensagens

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id          String       @id @default(cuid())
  title       String
  content     String
  folderId    String
  folder      Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  agendaCards AgendaCard[]
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([folderId, position])
}

model AgendaBoard {
  id          String         @id @default(cuid())
  name        String         @default("Minha Agenda")
  orientation String         @default("STATUS_COLUMNS")
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  statuses    AgendaStatus[]
  lanes       AgendaLane[]
  cards       AgendaCard[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId])
}

model AgendaStatus {
  id        String       @id @default(cuid())
  name      String
  color     String       @default("#3B82F6")
  position  Int
  boardId   String
  board     AgendaBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     AgendaCard[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([boardId, position])
}

model AgendaLane {
  id        String       @id @default(cuid())
  name      String
  position  Int
  boardId   String
  board     AgendaBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     AgendaCard[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([boardId, position])
}

model AgendaCard {
  id          String       @id @default(cuid())
  title       String
  description String?
  color       String       @default("#FDE68A")
  dueDate     DateTime?
  position    Int          @default(0)
  boardId     String
  board       AgendaBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  statusId    String
  status      AgendaStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  laneId      String
  lane        AgendaLane   @relation(fields: [laneId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?        @relation(fields: [noteId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([boardId, statusId, laneId])
  @@index([noteId])
}

model LibraryDocument {
  id            String                 @id @default(cuid())
  name          String
  mimeType      String
  fileType      String
  size          Int
  data          Bytes
  extractedText String
  summary       String?
  status        String                 @default("READY")
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        LibraryDocumentChunk[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId, createdAt])
}

model LibraryDocumentChunk {
  id         String                      @id @default(cuid())
  content    String
  position   Int
  embedding  Unsupported("vector(768)")?
  documentId String
  document   LibraryDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime                    @default(now())

  @@unique([documentId, position])
  @@index([documentId])
}
